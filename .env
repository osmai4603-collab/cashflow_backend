# Server Configuration
PORT=8070
READ_TIMEOUT_SECONDS=5
READ_HEADER_TIMEOUT_SECONDS=2
WRITE_TIMEOUT_SECONDS=10
IDLE_TIMEOUT_SECONDS=120
DRAIN_SECONDS=5
SHUTDOWN_SECONDS=10
MAX_HEADER_BYTES=1048576

# Reverse proxy mode (trust X-Forwarded-For / X-Real-IP, like Odoo --proxy-mode)
PROXY_MODE=false

# Storage Configuration ("postgres" or "memory")
STORAGE_DRIVER=postgres

# PostgreSQL Connection Settings
# Canonical names; legacy PG* aliases remain supported (PGHOST, PGPORT, PGUSER,
# PGPASSWORD, PGDATABASE, PGSSLMODE, PGAPPNAME, PGPATH, PGHOST_REPLICA,
# PGPORT_REPLICA, PGDATABASE_TEMPLATE).
DB_HOST=localhost
# Docker Postgres publishes on 5433 to avoid a clash with the system PostgreSQL 18 on 5432.
# The server container still talks to postgres:5432 internally (docker-compose.yml DB_PORT=5432).
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cashflow
DB_SSLMODE=disable

# Optional direct connection string override (takes precedence if set)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/cashflow?sslmode=disable

# Odoo database management proxy
ODOO_BASE_URL=http://127.0.0.1:8069
ODOO_MASTER_PASSWORD=admin
ODOO_TIMEOUT_SECONDS=20

# PostgreSQL Connection Pool Settings
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME_MINUTES=60
DB_MAX_CONN_IDLE_TIME_MINUTES=30

# Application Metadata & ERP Mode
APP_NAME=odoo_go_backend
APP_VERSION=0.1.0
COMPANY_MODE=single

# Cache & Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & Security (go run ./cmd/server -save to persist a hashed admin password)
JWT_SECRET=odoo-go-insecure-dev-secret-key-change-in-production
# ADMIN_PASSWD=

# Logging
LOG_LEVEL=info
# LOG_FILE=
# LOG_SYSLOG=false
# LOG_HANDLER=:INFO

# Workers & Limits (Odoo-style)
# WORKERS=0
# MAX_CRON_THREADS=2
# LIMIT_TIME_WORKER_CRON=60s
# LIMIT_TIME_REAL=120s
# LIMIT_MEMORY_SOFT=2147483648
# LIMIT_MEMORY_HARD=2684354560

# Runtime (module loading mirrors Odoo -i/-u/--dev)
# SERVER_WIDE_MODULES=base,web,rpc
# INIT_MODULES=
# UPDATE_MODULES=
# DEV_MODE=
# STOP_AFTER_INIT=false

# Config file selection (overrides default config/cashflow.json)
# CASHFLOW_RC=/path/to/cashflow.json

# ─────────────────────────────────────────────────────────────
# Management / Observability listener (dedicated 8066 port)
# metrics and pprof are NEVER served on the public port (8070).
# ─────────────────────────────────────────────────────────────
MANAGEMENT_ENABLED=true
MANAGEMENT_INTERFACE=127.0.0.1
MANAGEMENT_PORT=8066
MANAGEMENT_METRICS_ENABLED=true
# pprof is served ONLY on the management listener and ONLY when enabled here
# (never via query params or headers)
MANAGEMENT_PPROF_ENABLED=false
# Enable when the management listener is not network-isolated.
MANAGEMENT_REQUIRE_AUTH=false
# Mandatory when MANAGEMENT_REQUIRE_AUTH=true
# MANAGEMENT_AUTH_TOKEN=change-me

# P6 — Dev monitoring stack (Prometheus + Grafana, loopback-only)
# ───────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ALERTMANAGER_PORT=9093
# قناة إشعارات التنبيهات (webhook). غيّره إلى webhook الحقيقي
# (Slack/Teams/PagerDuty-style أو موزع داخلي). تركه كما هو موجود يبقي
# Alertmanager يعمل لكن التسليم للوجهة غير المتاحة سيفشل.
ALERTMANAGER_WEBHOOK_URL=http://127.0.0.1:9099/hook
